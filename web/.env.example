# Copy to .env.local and fill in. See docs/design.md §9.
# Never put secrets in NEXT_PUBLIC_* variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (AI_PROVIDER defaults to anthropic)
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=

# Embeddings (EMBEDDING_DIMENSIONS must match the vector column)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_API_KEY=

# Upstash Redis: rate limit and daily cost cap
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AGENT_DAILY_BUDGET_USD=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# n8n contact pipeline
N8N_CONTACT_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Knowledge base ingestion
GITHUB_TOKEN=

# Booking link offered by the agent
CAL_BOOKING_URL=
